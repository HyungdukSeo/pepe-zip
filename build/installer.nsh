; Remove per-user context menu / file association entries registered by the app
!macro customUnInstall
  DeleteRegKey HKCU "Software\Classes\*\shell\PePeZip"
  DeleteRegKey HKCU "Software\Classes\Directory\shell\PePeZip"
  DeleteRegKey HKCU "Software\Classes\PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.7z\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.7z\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.zip\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.zip\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.rar\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.rar\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tar\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.tar\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.gz\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.gz\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tgz\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.tgz\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.bz2\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.bz2\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.tbz2\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.tbz2\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.xz\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.xz\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.txz\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.txz\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.zst\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.zst\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.iso\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.iso\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.cab\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.cab\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.arj\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.arj\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.lzh\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.lzh\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.lha\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.lha\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.wim\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.wim\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.zipx\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.zipx\OpenWithProgids" "PePeZip.Archive"
  DeleteRegKey HKCU "Software\Classes\SystemFileAssociations\.001\shell\PePeZip"
  DeleteRegValue HKCU "Software\Classes\.001\OpenWithProgids" "PePeZip.Archive"
!macroend
